# Local-only test credentials for the Compose stack. `make up` copies this to .env if missing.
# Never reuse these anywhere else.
POSTGRES_PASSWORD=pg_local_only
DEBEZIUM_PASSWORD=dbz_local_only
LAKEKEEPER_DB_PASSWORD=lk_local_only
LAKEKEEPER_ENCRYPTION_KEY=lk_encryption_key_local_only_0123456789
S3_ACCESS_KEY=lake_local_access
S3_SECRET_KEY=lake_local_secret_0123456789
# HMAC key for deletion propagation (G8): subject handles and log pseudonyms. Losing it only breaks pseudonym joins.
FORGET_HMAC_KEY=forget_hmac_local_only_0123456789abcdef
