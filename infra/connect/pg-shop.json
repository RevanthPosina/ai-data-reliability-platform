{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "debezium",
  "database.password": "${DEBEZIUM_PASSWORD}",
  "database.dbname": "shop",
  "topic.prefix": "cdc",
  "plugin.name": "pgoutput",
  "slot.name": "dbz_shop",
  "publication.name": "dbz_pub",
  "publication.autocreate.mode": "disabled",
  "table.include.list": "public.help_articles",
  "snapshot.mode": "initial",
  "tombstones.on.delete": "true",
  "heartbeat.interval.ms": "10000",
  "heartbeat.action.query": "INSERT INTO dbz_heartbeat (id, ts) VALUES (1, now()) ON CONFLICT (id) DO UPDATE SET ts = EXCLUDED.ts",
  "key.converter": "io.confluent.connect.avro.AvroConverter",
  "key.converter.schema.registry.url": "http://redpanda:8081",
  "value.converter": "io.confluent.connect.avro.AvroConverter",
  "value.converter.schema.registry.url": "http://redpanda:8081",
  "topic.creation.default.replication.factor": "1",
  "topic.creation.default.partitions": "3",
  "topic.creation.default.message.timestamp.type": "LogAppendTime"
}
