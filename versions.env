# Single source of truth for pinned versions. Read by Compose, Dockerfiles, the Makefile,
# the run manifest and `scripts/check_versions.py` (which fails CI if docs/design.md drifts).
# Policy (ADR-0000): stable, non-prerelease, released on or before 2026-10-11 (>= 14 days old at pin time).

# --- containers (core profile) ---
POSTGRES_IMAGE=postgres:17.10-alpine
DEBEZIUM_VERSION=3.7.0.Final
CONFLUENT_CONVERTER_VERSION=8.3.2
REDPANDA_IMAGE=redpandadata/redpanda:v26.2.4
SPARK_VERSION=4.1.3
SPARK_IMAGE=apache/spark:4.1.3-scala2.13-java17-python3-ubuntu
SCALA_BINARY=2.13
SPARK_KAFKA_CLIENTS_VERSION=3.9.1
SPARK_COMMONS_POOL2_VERSION=2.12.1
ICEBERG_VERSION=1.12.0
LAKEKEEPER_IMAGE=quay.io/lakekeeper/catalog:v0.13.6
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.48
QDRANT_IMAGE=qdrant/qdrant:v1.19.2

# --- build-only images ---
MAVEN_IMAGE=maven:3.9.16-eclipse-temurin-17
PYTHON_IMAGE=python:3.12.14-slim-bookworm

# --- containers (other profiles) ---
TRINO_IMAGE=trinodb/trino:483
MARQUEZ_IMAGE=marquezproject/marquez:0.50.0

# --- python (app image + dev venv) ---
DAGSTER_VERSION=1.13.26
DAGSTER_LIB_VERSION=0.29.26
DBT_CORE_VERSION=1.12.5
DBT_TRINO_VERSION=1.10.6
OPENLINEAGE_VERSION=1.53.0
PYICEBERG_VERSION=0.12.0
QDRANT_CLIENT_VERSION=1.19.1
SENTENCE_TRANSFORMERS_VERSION=6.1.0
TORCH_VERSION=2.14.1
FASTAVRO_VERSION=1.13.1
# The Spark 4.1.3 image ships Python 3.10: fastavro 1.13 and hypothesis 6.169 need >= 3.11, so the Spark image
# pins fastavro 1.12.2 and hypothesis 6.168.5 (docker/spark/requirements.txt).
SPARK_FASTAVRO_VERSION=1.12.2
SPARK_HYPOTHESIS_VERSION=6.168.5
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
BOTO3_VERSION=1.43.111
PSYCOPG_VERSION=3.3.6

# --- iceberg table policy ---
ICEBERG_FORMAT_VERSION=2
